# Copy to `.env` and fill in the credentials for whichever route(s) you use.
# The model is chosen per run with `--model` (a litellm model id); its provider
# prefix selects which pair of variables below is used — see
# surveilbench/providers.py.

# --- Hugging Face (required to download the gated dataset) -------------------
# Request access at https://huggingface.co/datasets/juniworld/surveilbench,
# then `huggingface-cli login` or set the token here.
HF_TOKEN=

# --- Default route: everything without a more specific route below ----------
# Not just openai/* — non-OpenAI model ids (deepseek/, xai/, moonshot/, ...) are
# reached through this OpenAI-compatible gateway and authenticate with this key.
OPENAI_API_KEY=
OPENAI_API_BASE=

# --- Anthropic ( --model anthropic/claude-sonnet-4-6 ) ----------------------
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=

# --- Called directly, no base URL override ----------------------------------
# --model gemini/gemini-2.5-pro
GEMINI_API_KEY=
# --model fireworks_ai/glm-5.1
FIREWORKS_AI_API_KEY=
