# Copy to `.env` and fill in the keys for whichever provider(s) you use.
# The model is chosen per run with `--model` (a litellm model id); litellm routes
# to the matching provider using the keys below. You only need the key(s) for the
# provider(s) you actually call.

# --- Hugging Face (required to download the gated dataset) -------------------
# Request access at https://huggingface.co/datasets/juniworld/surveilbench,
# then `huggingface-cli login` or set the token here.
HF_TOKEN=

# --- Anthropic ( --model anthropic/claude-sonnet-4-6 ) ----------------------
ANTHROPIC_API_KEY=

# --- OpenAI ( --model openai/gpt-5.4 ) --------------------------------------
OPENAI_API_KEY=
# OPENAI_API_BASE=

# --- Amazon Bedrock ( --model bedrock/us.anthropic.claude-sonnet-4-6 ) ------
# Requires the optional `bedrock` extra: pip install "surveilbench[bedrock]"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# --- Google Gemini ( --model gemini/gemini-2.5-pro ) ------------------------
GEMINI_API_KEY=

# --- Other providers litellm supports (optional) ----------------------------
DEEPSEEK_API_KEY=
FIREWORKS_AI_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=
